# Clave de la API de Claude (sin ella la app funciona en MODO DEMO)
ANTHROPIC_API_KEY=
# Modelo (por defecto claude-opus-5-5; claude-haiku-5-5 es mucho más barato para escalar)
CLAUDE_MODEL=claude-opus-5-5
PORT=3000
# Mensajes con IA por día en el plan gratis
FREE_DAILY_LIMIT=15
# Códigos Premium válidos separados por coma (MVP; en producción usar suscripciones)
PREMIUM_CODES=
